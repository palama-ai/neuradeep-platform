generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String        @id @default(uuid())
  email              String        @unique
  passwordHash       String
  fullName           String?
  profileImage       String?
  role               String        @default("user")
  plan               String        @default("free")
  credits            Int           @default(500)
  creditsTotal       Int           @default(500)
  creditsConsumed    Int           @default(0)
  referralCode       String        @unique @default(uuid())
  referredBy         String?
  referralCount      Int           @default(0)
  referralEarnings   Int           @default(0)
  planCreditsMonthly Int           @default(0)
  planResetDate      DateTime?
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  lastFeedbackAt     DateTime?
  chatSessions       ChatSession[]
  creditLogs         CreditLog[]
  feedbacks          Feedback[]
  referredByRef      Referral?     @relation("Referee")
  referrals          Referral[]    @relation("Referrer")
  sessions           Session[]
  usageLogs          UsageLog[]
}

model CreditLog {
  id           BigInt   @id @default(autoincrement())
  userId       String
  amount       Int
  type         String
  model        String?
  provider     String?
  inputTokens  Int?
  outputTokens Int?
  multiplier   Float?
  taskType     String?
  description  String?
  balanceAfter Int
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, type])
  @@index([createdAt])
}

model Referral {
  id             String   @id @default(uuid())
  referrerId     String
  refereeId      String   @unique
  creditsAwarded Int      @default(500)
  status         String   @default("completed")
  createdAt      DateTime @default(now())
  referee        User     @relation("Referee", fields: [refereeId], references: [id])
  referrer       User     @relation("Referrer", fields: [referrerId], references: [id])

  @@index([referrerId])
}

model ApiKey {
  id            String   @id @default(uuid())
  provider      String
  apiKey        String
  isActive      Boolean  @default(true)
  monthlyBudget Decimal? @default(0)
  currentSpend  Decimal  @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  updatedById   String?
}

model UsageLog {
  id           BigInt   @id @default(autoincrement())
  userId       String
  model        String
  provider     String
  inputTokens  Int
  outputTokens Int
  totalTokens  Int
  costUsd      Decimal
  taskType     String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([model])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model GlobalConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model ChatSession {
  id        String        @id @default(uuid())
  userId    String
  title     String?       @default("New Chat")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
  user      User          @relation(fields: [userId], references: [id])
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id])
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}
