{
  "version": 2,
  "name": "neuradeepai-platform",
  "builds": [
    {
      "src": "server/src/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "server/src/index.js"
    },
    {
      "source": "/(auth|dashboard|settings|admin)(.*)",
      "destination": "client/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ]
}
