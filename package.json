{
  "name": "neuradeepai-platform",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "postinstall": "npm run build:prisma --workspace=server",
    "build:prisma": "npm run build:prisma --workspace=server",
    "build": "npm run build --workspace=client",
